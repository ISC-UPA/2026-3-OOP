@startuml EsUn_TieneUn
skinparam classAttributeIconSize 0
left to right direction

class Persona {
  + {static} conteo: int
  + nombre: str
  + _nacimiento: date
  - __sexo: bool

  + {static} calcularEdad(birthdate) : int
  + __init__(nombre, sexo, nacimiento)
  + getSexo() : str
  + setSexo(value)
  + info() : str
}

class Estudiante {
  + carrera: str

  + __init__(nombre, sexo, nacimiento, carrera)
  + trabajar() : str
  + info() : str
}

class Empleado {
  + puesto: str
  + salario: float
  + cuenta: CuentaBancaria

  + __init__(nombre, sexo, nacimiento, puesto, salario)
  + trabajar() : str
  + info() : str
}

class CuentaBancaria {
  + titular: str
  - __saldo: float

  + __init__(titular, saldo_inicial=0.0)
  + getSaldo() : float
  + depositar(cantidad)
  + retirar(cantidad)

}

Persona <|-- Estudiante
Persona <|-- Empleado
Empleado *-- CuentaBancaria
@enduml